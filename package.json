{
  "name": "11ty-uswds-template",
  "version": "0.0.2",
  "description": "A 11ty UWDS template.",
  "main": "index.js",
  "scripts": {
    "build": "npm run assets:build && npx @11ty/eleventy",
    "assets:autoprefix": "postcss \"_site/assets/styles/**/*.css\" -r --use autoprefixer",
    "assets:build": "node ./config/buildAssets && npm run assets:autoprefix",
    "assets:clean": "rimraf _site/assets",
    "assets:stamp": "node -e \"require('fs').writeFileSync('_data/buildStamp.json', JSON.stringify({ts: Date.now()}))\"",
    "assets:refresh": "npm run assets:clean && npm run assets:build && npm run assets:stamp",
    "assets:watch": "chokidar 'js/**' 'styles/**' -c 'npm run assets:refresh' --polling",
    "clean": "rimraf _site",
    "dev:clean": "npm run clean && npm run dev",
    "dev:assets": "npm run assets:refresh && npm run assets:watch",
    "dev:debug": "DEBUG=* npx @11ty/eleventy --serve --watch",
    "dev:serve": "npx @11ty/eleventy --serve --watch",
    "dev": "concurrently -k \"npm:dev:serve\" \"npm:dev:assets\"",
    "federalist": "npm run build",
    "pa11y-ci": "npx pa11y-ci",
    "pa11y": "npx start-server-and-test start 8080 pa11y-ci:sitemap",
    "pa11y-ci:sitemap": "pa11y-ci --sitemap http://localhost:8080/sitemap.xml --sitemap-exclude \"/*.pdf\"  --sitemap-exclude \"/admin\" --sitemap-find \"^/\" --sitemap-replace \"http://localhost:8080/\"",
    "serve": "npx @11ty/eleventy --serve",
    "start": "npx @11ty/eleventy --serve",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "author": "",
  "license": "CC0-1.0",
  "devDependencies": {
    "@11ty/eleventy": "^3.1.7",
    "@11ty/eleventy-img": "^7.1.1",
    "@11ty/eleventy-navigation": "^1.0.5",
    "@11ty/eleventy-plugin-rss": "^3.1.0",
    "autoprefixer": "^10.6.1",
    "browser-sync": "^3.0.4",
    "chokidar-cli": "^3.0.0",
    "concurrently": "^10.0.6",
    "dotenv": "^18.0.9",
    "eleventy-plugin-svg-sprite": "^2.4.6",
    "esbuild": "^0.28.2",
    "esbuild-sass-plugin": "^3.7.0",
    "js-yaml": "^5.5.0",
    "luxon": "^3.5.0",
    "markdown-it": "^14.1.1",
    "markdown-it-anchor": "^10.0.0",
    "npm-run-all": "^4.1.5",
    "postcss": "^8.5.31",
    "postcss-cli": "^12.0.0",
    "rimraf": "^6.1.3"
  },
  "dependencies": {
    "@uswds/uswds": "3.14.0",
    "gulp": "^5.0.1",
    "markdown-it-attrs": "^5.0.1",
    "pa11y-ci": "^5.0.0",
    "start-server-and-test": "^3.0.13"
  }
}
